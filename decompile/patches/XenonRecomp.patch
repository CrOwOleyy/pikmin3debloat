+// --- Paired-single (Gekko) quantized load/store helpers (Pikmin 3 Recomp fork) ---
+// GQR quantization types : 0/1/2/3 = single float, 4 = u8, 5 = u16, 6 = s8, 7 = s16.
+// (big-endian memory ; scale = facteur 2^-scale en load, 2^+scale en store)
+static inline float PPCDequantizeLoad(uint8_t* base, uint32_t ea, uint32_t type, int32_t scale)
+{
+    switch (type & 7)
+    {
+    case 4: return __builtin_ldexpf((float)(*(volatile uint8_t*)(base + ea)), -scale);               // u8
+    case 6: return __builtin_ldexpf((float)(*(volatile int8_t*)(base + ea)), -scale);                // s8
+    case 5: return __builtin_ldexpf((float)(uint16_t)__builtin_bswap16(*(volatile uint16_t*)(base + ea)), -scale); // u16
+    case 7: return __builtin_ldexpf((float)(int16_t)__builtin_bswap16(*(volatile uint16_t*)(base + ea)), -scale);  // s16
+    default: { uint32_t u = __builtin_bswap32(*(volatile uint32_t*)(base + ea)); float f; __builtin_memcpy(&f, &u, 4); return f; }
+    }
+}
+
+static inline void PPCQuantizeStore(uint8_t* base, uint32_t ea, float value, uint32_t type, int32_t scale)
+{
+    switch (type & 7)
+    {
+    case 4: { int v = (int)__builtin_ldexpf(value, scale); v = v < 0 ? 0 : (v > 255 ? 255 : v); *(volatile uint8_t*)(base + ea) = (uint8_t)v; return; }
+    case 6: { int v = (int)__builtin_ldexpf(value, scale); v = v < -128 ? -128 : (v > 127 ? 127 : v); *(volatile int8_t*)(base + ea) = (int8_t)v; return; }
+    case 5: { int v = (int)__builtin_ldexpf(value, scale); v = v < 0 ? 0 : (v > 65535 ? 65535 : v); *(volatile uint16_t*)(base + ea) = __builtin_bswap16((uint16_t)v); return; }
+    case 7: { int v = (int)__builtin_ldexpf(value, scale); v = v < -32768 ? -32768 : (v > 32767 ? 32767 : v); *(volatile uint16_t*)(base + ea) = __builtin_bswap16((uint16_t)(int16_t)v); return; }
+    default: { uint32_t u; __builtin_memcpy(&u, &value, 4); *(volatile uint32_t*)(base + ea) = __builtin_bswap32(u); return; }
+    }
+}
+
+// psq_l / psq_st : charge/stocke 2 éléments quantifiés selon le GQR (W=1 => ps1 non chargé = 1.0).
+static inline uint32_t PPCPairedStride(uint32_t type) { return (type & 4) ? ((type & 1) ? 2u : 1u) : 4u; }
+
+static inline void PPCLoadPaired(uint8_t* base, uint32_t ea, uint32_t gqr, uint32_t w, double& ps0, double& ps1)
+{
+    uint32_t type = (gqr >> 16) & 7;
+    int32_t  scale = (int32_t)(((gqr >> 24) & 0x3F) ^ 0x20) - 0x20;
+    ps0 = (double)PPCDequantizeLoad(base, ea, type, scale);
+    ps1 = w ? 1.0 : (double)PPCDequantizeLoad(base, ea + PPCPairedStride(type), type, scale);
+}
+
+static inline void PPCStorePaired(uint8_t* base, uint32_t ea, uint32_t gqr, uint32_t w, double ps0, double ps1)
+{
+    uint32_t type = gqr & 7;
+    int32_t  scale = (int32_t)(((gqr >> 8) & 0x3F) ^ 0x20) - 0x20;
+    PPCQuantizeStore(base, ea, (float)ps0, type, scale);
+    if (!w)
+        PPCQuantizeStore(base, ea + PPCPairedStride(type), (float)ps1, type, scale);
+}
