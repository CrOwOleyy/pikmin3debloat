+            fmt::format("{}.f64", f(insn.operands[2])), false);
+        break;
+
+    case PPC_INST_PS_MERGE11: // ps0=A.ps1, ps1=B.ps1
+        printSetFlushMode(false);
+        emitPaired(insn.operands[0],
+            fmt::format("{}.f64", ps1(insn.operands[1])),
+            fmt::format("{}.f64", ps1(insn.operands[2])), false);
+        break;
+
+    case PPC_INST_PS_CMPU0:
+    case PPC_INST_PS_CMPO0: // compare ps0 de A et B dans le champ CR
+        printSetFlushMode(false);
+        println("\t{}.compare({}.f64, {}.f64);", cr(insn.operands[0]), f(insn.operands[1]), f(insn.operands[2]));
+        break;
+
+    case PPC_INST_PSQ_L: // [D, d, rA, W, I]
+        printSetFlushMode(false);
+        print("\tPPCLoadPaired(base, ");
+        if (insn.operands[2] != 0)
+            print("{}.u32 + ", r(insn.operands[2]));
+        println("{}, ctx.gqr[{}], {}, {}.f64, {}.f64);",
+            int32_t(insn.operands[1]), insn.operands[4], insn.operands[3], f(insn.operands[0]), ps1(insn.operands[0]));
+        break;
+
+    case PPC_INST_PSQ_ST: // [S, d, rA, W, I]
+        printSetFlushMode(false);
+        print("\tPPCStorePaired(base, ");
+        if (insn.operands[2] != 0)
+            print("{}.u32 + ", r(insn.operands[2]));
+        println("{}, ctx.gqr[{}], {}, {}.f64, {}.f64);",
+            int32_t(insn.operands[1]), insn.operands[4], insn.operands[3], f(insn.operands[0]), ps1(insn.operands[0]));
+        break;
+
+    case PPC_INST_MTSPR: // [spr, rS] : seuls les GQR nous intéressent
+        if (insn.operands[0] >= 896 && insn.operands[0] <= 903)
+            println("\tctx.gqr[{}] = {}.u32;", insn.operands[0] - 896, r(insn.operands[1]));
+        else if (insn.operands[0] >= 912 && insn.operands[0] <= 919)
+            println("\tctx.gqr[{}] = {}.u32;", insn.operands[0] - 912, r(insn.operands[1]));
+        // autres SPR (HID/config…) : non pertinents pour la recomp -> ignorés
+        break;
+
+    case PPC_INST_MFSPR: // [rD, spr]
+        if (insn.operands[1] >= 896 && insn.operands[1] <= 903)
+            println("\t{}.u32 = ctx.gqr[{}];", r(insn.operands[0]), insn.operands[1] - 896);
+        else if (insn.operands[1] >= 912 && insn.operands[1] <= 919)
+            println("\t{}.u32 = ctx.gqr[{}];", r(insn.operands[0]), insn.operands[1] - 912);
+        else
+            println("\t{}.u64 = 0;", r(insn.operands[0]));
+        break;
+
+    // --- Instructions PowerPC 32 bits absentes du code Xbox 360 (fork Pikmin 3 Recomp) ---
+    // Le compilateur Green Hills de la Wii U les emploie (prologues lmw/stmw, copies
+    // lswi/stswi, accès avec mise à jour…) ; XenonRecomp les sautait silencieusement.
+    case PPC_INST_LMW:
+        println("\t{} = {}{};", ea(), insn.operands[2] != 0 ? fmt::format("{}.u32 + ", r(insn.operands[2])) : "", int32_t(insn.operands[1]));
+        for (uint32_t i = insn.operands[0]; i < 32; i++)
+            println("\t{}.u64 = PPC_LOAD_U32({} + {});", r(i), ea(), (i - insn.operands[0]) * 4);
+        break;
+
+    case PPC_INST_STMW:
+        println("\t{} = {}{};", ea(), insn.operands[2] != 0 ? fmt::format("{}.u32 + ", r(insn.operands[2])) : "", int32_t(insn.operands[1]));
+        for (uint32_t i = insn.operands[0]; i < 32; i++)
+            println("\tPPC_STORE_U32({} + {}, {}.u32);", ea(), (i - insn.operands[0]) * 4, r(i));
+        break;
+
+    case PPC_INST_LSWI:
+    case PPC_INST_STSWI:
+    {
+        const bool load = insn.opcode->id == PPC_INST_LSWI;
+        const uint32_t count = insn.operands[2] == 0 ? 32 : insn.operands[2];
+        println("\t{} = {};", ea(), insn.operands[1] != 0 ? fmt::format("{}.u32", r(insn.operands[1])) : "0");
+        for (uint32_t b = 0; b < count; b++)
+        {
+            const uint32_t reg = (insn.operands[0] + b / 4) % 32;
+            const uint32_t shift = 24 - 8 * (b % 4);
+            if (load)
+            {
+                if (b % 4 == 0)
+                    println("\t{}.u64 = 0;", r(reg));
+                println("\t{}.u32 |= uint32_t(PPC_LOAD_U8({} + {})) << {};", r(reg), ea(), b, shift);
+            }
+            else
+            {
+                println("\tPPC_STORE_U8({} + {}, uint8_t({}.u32 >> {}));", ea(), b, r(reg), shift);
+            }
+        }
+        break;
+    }
+
+    case PPC_INST_LHZU:
+    case PPC_INST_LHAU:
+    case PPC_INST_STHU:
+    case PPC_INST_LFSU:
+    case PPC_INST_LFDU:
+    case PPC_INST_STFSU:
+    case PPC_INST_STFDU:
+    case PPC_INST_LWZUX:
+    case PPC_INST_LHZUX:
+    case PPC_INST_LHAUX:
+    case PPC_INST_LBZUX:
+    case PPC_INST_STBUX:
+    case PPC_INST_STHUX:
+    case PPC_INST_LFSUX:
+    case PPC_INST_STFSUX:
+    {
+        const auto id = insn.opcode->id;
+        const bool indexed = id == PPC_INST_LWZUX || id == PPC_INST_LHZUX || id == PPC_INST_LHAUX || id == PPC_INST_LBZUX ||
+            id == PPC_INST_STBUX || id == PPC_INST_STHUX || id == PPC_INST_LFSUX || id == PPC_INST_STFSUX;
+        const uint32_t ra = indexed ? insn.operands[1] : insn.operands[2];
+        if (indexed)
+            println("\t{} = {}.u32 + {}.u32;", ea(), r(ra), r(insn.operands[2]));
+        else
+            println("\t{} = {} + {}.u32;", ea(), int32_t(insn.operands[1]), r(ra));
+
+        const uint32_t d = insn.operands[0];
+        switch (id)
+        {
+        case PPC_INST_LHZU:
+        case PPC_INST_LHZUX:
+            println("\t{}.u64 = PPC_LOAD_U16({});", r(d), ea());
+            break;
+        case PPC_INST_LHAU:
+        case PPC_INST_LHAUX:
+            println("\t{}.s64 = int16_t(PPC_LOAD_U16({}));", r(d), ea());
+            break;
+        case PPC_INST_LWZUX:
+            println("\t{}.u64 = PPC_LOAD_U32({});", r(d), ea());
+            break;
+        case PPC_INST_LBZUX:
+            println("\t{}.u64 = PPC_LOAD_U8({});", r(d), ea());
+            break;
+        case PPC_INST_STHU:
+        case PPC_INST_STHUX:
+            println("\tPPC_STORE_U16({}, {}.u16);", ea(), r(d));
+            break;
+        case PPC_INST_STBUX:
+            println("\tPPC_STORE_U8({}, {}.u8);", ea(), r(d));
+            break;
+        case PPC_INST_LFSU:
+        case PPC_INST_LFSUX:
+            printSetFlushMode(false);
+            println("\t{}.u32 = PPC_LOAD_U32({});", temp(), ea());
+            println("\t{}.f64 = double({}.f32);", f(d), temp());
+            splatPs1(d);
+            break;
+        case PPC_INST_LFDU:
+            printSetFlushMode(false);
+            println("\t{}.u64 = PPC_LOAD_U64({});", f(d), ea());
+            break;
+        case PPC_INST_STFSU:
+        case PPC_INST_STFSUX:
+            printSetFlushMode(false);
+            println("\t{}.f32 = float({}.f64);", temp(), f(d));
+            println("\tPPC_STORE_U32({}, {}.u32);", ea(), temp());
+            break;
+        case PPC_INST_STFDU:
+            printSetFlushMode(false);
+            println("\tPPC_STORE_U64({}, {}.u64);", ea(), f(d));
+            break;
+        }
+        println("\t{}.u32 = {};", r(ra), ea());
+        break;
+    }
+
+    case PPC_INST_ADDC:
+        println("\t{}.ca = {}.u32 + {}.u32 < {}.u32;", xer(), r(insn.operands[1]), r(insn.operands[2]), r(insn.operands[1]));
+        println("\t{}.u64 = {}.u64 + {}.u64;", r(insn.operands[0]), r(insn.operands[1]), r(insn.operands[2]));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.compare<int32_t>({}.s32, 0, {});", cr(0), r(insn.operands[0]), xer());
+        break;
+
+    case PPC_INST_ADDME:
+    case PPC_INST_SUBFZE:
+    case PPC_INST_SUBFME:
+    {
+        const auto id = insn.opcode->id;
+        const char* operand = id == PPC_INST_ADDME ? "" : "~";
+        const char* addend = id == PPC_INST_SUBFZE ? "" : " + 0xFFFFFFFFull";
+        println("\t{}.u64 = uint64_t(uint32_t({}{}.u32)) + {}.ca{};", temp(), operand, r(insn.operands[1]), xer(), addend);
+        println("\t{}.ca = ({}.u64 >> 32) != 0;", xer(), temp());
+        println("\t{}.u64 = {}.u32;", r(insn.operands[0]), temp());
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.compare<int32_t>({}.s32, 0, {});", cr(0), r(insn.operands[0]), xer());
+        break;
+    }
+
+    case PPC_INST_EQV:
+        println("\t{}.u64 = ~({}.u64 ^ {}.u64);", r(insn.operands[0]), r(insn.operands[1]), r(insn.operands[2]));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.compare<int32_t>({}.s32, 0, {});", cr(0), r(insn.operands[0]), xer());
+        break;
+
+    case PPC_INST_RLWNM:
+        println("\t{}.u64 = __builtin_rotateleft32({}.u32, {}.u8 & 0x1F) & 0x{:X};", r(insn.operands[0]), r(insn.operands[1]), r(insn.operands[2]),
+            ComputeMask(insn.operands[3] + 32, insn.operands[4] + 32) & 0xFFFFFFFF);
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.compare<int32_t>({}.s32, 0, {});", cr(0), r(insn.operands[0]), xer());
+        break;
+
+    case PPC_INST_FRSQRTE:
+        printSetFlushMode(false);
+        println("\t{}.f64 = 1.0 / __builtin_sqrt({}.f64);", f(insn.operands[0]), f(insn.operands[1]));
+        break;
+
+    case PPC_INST_CRCLR:
+    case PPC_INST_CRSET:
+    {
+        static const char* bits[] = { "lt", "gt", "eq", "so" };
+        println("\t{}.{} = {};", cr(insn.operands[0] / 4), bits[insn.operands[0] % 4], insn.opcode->id == PPC_INST_CRSET ? 1 : 0);
+        break;
+    }
+
+    case PPC_INST_BNEL:
+    case PPC_INST_BEQL:
+        println("\tif ({}{}.eq) {{", insn.opcode->id == PPC_INST_BNEL ? "!" : "", cr(insn.operands[0]));
+        if (!config.skipLr)
+            println("\t\tctx.lr = 0x{:X};", base + 4);
+        print("\t");
+        printFunctionCall(insn.operands[1]);
+        println("\t}}");
+        csrState = CSRState::Unknown; // the call could change it
+        break;
+
+    case PPC_INST_TW:
+    {
+        const uint32_t to = insn.operands[0];
+        if (to == 31)
+        {
+            println("\tPPC_TRAP(0x{:X});", base);
+            break;
+        }
+        std::string cond;
+        auto add = [&](const std::string& c) { cond += cond.empty() ? c : " || " + c; };
+        const auto a = r(insn.operands[1]);
+        const auto b = r(insn.operands[2]);
+        if (to & 0x10) add(fmt::format("{}.s32 < {}.s32", a, b));
+        if (to & 0x08) add(fmt::format("{}.s32 > {}.s32", a, b));
+        if (to & 0x04) add(fmt::format("{}.u32 == {}.u32", a, b));
+        if (to & 0x02) add(fmt::format("{}.u32 < {}.u32", a, b));
+        if (to & 0x01) add(fmt::format("{}.u32 > {}.u32", a, b));
+        if (!cond.empty())
+            println("\tif ({}) PPC_TRAP(0x{:X});", cond, base);
+        break;
+    }
+
+    case PPC_INST_ISYNC:
+    case PPC_INST_DCBST:
+        // no op
+        break;
+
     default:
         return false;
     }
