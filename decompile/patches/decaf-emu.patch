+      mSpv->addCapability(spv::CapabilityImageQuery);
+      auto texVarType = mSpv->textureVarType(textureId, texDim, texFormat);
+      auto texVal = mSpv->createLoad(mSpv->textureVar(textureId, texDim, texFormat), spv::NoPrecision);
+      auto sampVal = mSpv->createLoad(mSpv->samplerVar(samplerId), spv::NoPrecision);
+      auto sampledVal = mSpv->createOp(spv::OpSampledImage, mSpv->makeSampledImageType(texVarType), { texVal, sampVal });
+
+      auto srcGprVal = mSpv->readGprMaskRef(srcGpr);
+      spv::Id coords;
+      switch (texDim) {
+      case latte::SQ_TEX_DIM::DIM_1D:
+      case latte::SQ_TEX_DIM::DIM_1D_ARRAY:
+         coords = mSpv->createOp(spv::OpCompositeExtract, mSpv->floatType(), { srcGprVal, 0 });
+         break;
+      case latte::SQ_TEX_DIM::DIM_3D:
