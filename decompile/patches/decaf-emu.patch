+// Data buffers (vertices, indices, uniforms...) get a memory cache per address and size,
+// and games move these around every frame (ring buffers): without eviction the caches pile
+// up until the GPU heap is full.  Drop the ones unused for a while whose contents are also
+// in guest memory (not GPU written); the buffer is destroyed once the GPU is done with the
+// current batch.
+void
+Driver::evictMemCaches()
+{
+   static constexpr uint64_t UnusedBatches = 300;
+
+   static const bool debugMem = getenv("DECAF_DEBUG_MEMCACHE") != nullptr;
+   if (debugMem && mActiveBatchIndex % 1024 == 0) {
+      VmaStats stats;
+      vmaCalculateStats(mAllocator, &stats);
+      gLog->info("VRAM used {} MB in {} allocations ({} blocks), {} memcaches, {} surfaces",
+                 stats.total.usedBytes >> 20, stats.total.allocationCount, stats.total.blockCount,
+                 mMemCaches.size(), mSurfaces.size());
+   }
+   if (mActiveBatchIndex < UnusedBatches) {
+      return;
+   }
+
+   std::vector<MemCacheObject *> evicted;
+   for (auto it = mMemCaches.begin(); it != mMemCaches.end(); ) {
+      MemCacheObject **link = &it->second;
+      while (*link) {
+         auto cache = *link;
+         auto evict = cache->isData && !cache->isSurface &&
+                      cache->lastUsageIndex + UnusedBatches < mActiveBatchIndex &&
+                      !cache->delayedWriteFunc;
+
+         if (evict) {
+            for (auto &record : mDirtyMemCaches) {
+               evict = evict && record.cache != cache;
+            }
+         }
+
+         if (evict) {
+            forEachSectionSegment(cache, { 0, cache->numSections }, [&](MemCacheSection&, MemSegment& segment) {
+               if (segment.lastChangeOwner == cache && segment.gpuWritten) {
+                  evict = false;
+               }
+            });
+         }
+
+         if (!evict) {
+            link = &cache->nextObject;
+            continue;
+         }
+
+         forEachSectionSegment(cache, { 0, cache->numSections }, [&](MemCacheSection&, MemSegment& segment) {
+            if (segment.lastChangeOwner == cache) {
+               segment.lastChangeOwner = nullptr;
+            }
+         });
+
+         *link = cache->nextObject;
+         evicted.push_back(cache);
+      }
+
+      if (!it->second) {
+         it = mMemCaches.erase(it);
+      } else {
+         ++it;
+      }
+   }
+
+   if (evicted.empty()) {
+      return;
+   }
+
+   // Forget the cached draw state pointing at them
+   auto forget = [&](auto *&pointer) {
+      for (auto cache : evicted) {
+         if (pointer == cache) {
+            pointer = nullptr;
+         }
+      }
+   };
+   for (auto &buffer : mDrawCache.attribBuffers) {
+      forget(buffer);
+   }
+   for (auto &stage : mDrawCache.uniformBlocks) {
+      for (auto &buffer : stage) {
+         forget(buffer);
+      }
+   }
+   for (auto &buffer : mDrawCache.streamOutBuffers) {
+      forget(buffer);
+   }
+   forget(mDrawCache.opaqueBuffer);
+
+   auto allocator = mAllocator;
+   addRetireTask([=]() {
+      for (auto cache : evicted) {
+         vmaDestroyBuffer(allocator, cache->buffer, cache->allocation);
+         delete cache;
+      }
+   });
+}
