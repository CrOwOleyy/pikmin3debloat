# Dérivés du binaire et des fichiers du jeu (régénérables avec scripts/, voir recomp/README.md)
extracted/
ghidra/
recomp/carrot_linked.elf
recomp/generated/
recomp/runtime/generated/
recomp/config/*
!recomp/config/carrot_functions.toml
recomp/content_override/

# Outils tiers : decaf-emu, XenonRecomp et Vulkan-Headers sont des sous-modules (leurs modifications
# sont dans patches/*.patch, appliquées par setup.ps1) ; le reste est local.
tools/*
!tools/decaf-emu
!tools/XenonRecomp
!tools/Vulkan-Headers

# Compilation et diagnostics
recomp/build/
recomp/gpu/build/
capture/
recomp/dump/
recomp/rdoc/
recomp/rdoc_*/
